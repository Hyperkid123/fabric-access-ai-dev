{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lpichler/team-productivity-utils/schemas/review/review.schema.json",
  "title": "Unified Review Format",
  "description": "General-purpose JSON schema for the AI-assisted code review automation cycle. Covers initial review, verification of addressed findings, and future review stages. Extensible via review_type discriminator.",
  "type": "object",
  "required": ["review"],
  "additionalProperties": false,
  "properties": {
    "review": {
      "type": "object",
      "required": ["review_type", "pr", "generated", "findings"],
      "properties": {
        "review_type": {
          "type": "string",
          "enum": ["review", "verify"],
          "description": "Stage in the review lifecycle: 'review' for initial findings, 'verify' for follow-up verification."
        },
        "pr": { "$ref": "#/$defs/pr" },
        "generated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when this review was generated."
        },
        "total_deduped_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unique findings after deduplication."
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "review_type": { "const": "review" } },
            "required": ["review_type"]
          },
          "then": {
            "required": ["dimensions_dispatched", "total_raw_findings", "consensus_findings"],
            "properties": {
              "dimensions_dispatched": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of review dimensions that ran."
              },
              "total_raw_findings": {
                "type": "integer",
                "minimum": 0,
                "description": "Total findings before deduplication."
              },
              "consensus_findings": {
                "type": "integer",
                "minimum": 0,
                "description": "Findings agreed by consensus_threshold or more dimensions."
              }
            }
          }
        },
        {
          "if": {
            "properties": { "review_type": { "const": "verify" } },
            "required": ["review_type"]
          },
          "then": {
            "required": ["checked_commit", "original_review", "summary"],
            "properties": {
              "checked_commit": {
                "type": "string",
                "description": "Short SHA of the latest commit checked against."
              },
              "original_review": { "$ref": "#/$defs/original_review" },
              "summary": { "$ref": "#/$defs/verify_summary" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "pr": {
      "type": "object",
      "required": ["number", "title", "url"],
      "properties": {
        "number": { "type": "integer" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "alternative": {
      "type": "object",
      "required": ["approach", "trade_off"],
      "properties": {
        "approach": { "type": "string" },
        "trade_off": { "type": "string" },
        "recommended": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "file", "severity", "finding", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Finding number as string."
        },
        "file": {
          "type": "string",
          "description": "File path relative to repo root."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Approximate line number."
        },
        "severity": { "$ref": "#/$defs/severity" },
        "dimension": {
          "type": "string",
          "description": "Primary review dimension that found this."
        },
        "source_skill": {
          "type": "string",
          "description": "Plugin identifier of the source skill."
        },
        "source_repo": {
          "type": "string",
          "description": "Repository containing the source skill."
        },
        "finding": {
          "type": "string",
          "description": "Description of the issue."
        },
        "evidence": {
          "type": "string",
          "description": "Code or context supporting the finding."
        },
        "suggestion": {
          "type": "string",
          "description": "Suggested fix or improvement."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score (0-1)."
        },
        "agreed_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dimension names that independently found this."
        },
        "agreed_by_skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Source skill identifiers for each agreeing dimension."
        },
        "agreed_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of dimensions that agree."
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" },
          "description": "Alternative approaches to fix the issue."
        },
        "status": {
          "type": "string",
          "enum": ["addressed", "partially_addressed", "not_addressed", "out_of_scope", "superseded"],
          "description": "Verification status (verify review_type only)."
        },
        "status_evidence": {
          "type": "string",
          "description": "One sentence explaining the status classification (verify review_type only)."
        },
        "still_needed": {
          "type": ["string", "null"],
          "description": "What remains to be done (partially_addressed only, null otherwise)."
        }
      },
      "additionalProperties": false
    },
    "original_review": {
      "type": "object",
      "required": ["review_type", "total_findings"],
      "properties": {
        "review_type": {
          "type": "string",
          "const": "review"
        },
        "generated": {
          "type": "string",
          "format": "date-time"
        },
        "dimensions_dispatched": {
          "type": "integer",
          "minimum": 1
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "verify_summary": {
      "type": "object",
      "required": ["addressed", "partially_addressed", "not_addressed", "out_of_scope", "superseded"],
      "properties": {
        "addressed": { "type": "integer", "minimum": 0 },
        "partially_addressed": { "type": "integer", "minimum": 0 },
        "not_addressed": { "type": "integer", "minimum": 0 },
        "out_of_scope": { "type": "integer", "minimum": 0 },
        "superseded": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
